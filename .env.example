# Public URL of the site (used for HitPay redirect and webhook URLs)
SITE_URL=https://yanachocolateria.com

# HitPay: Dashboard > Settings > Payment Gateway > API Keys
HITPAY_API_KEY=
HITPAY_SALT=
# Salt of the webhook registered under HitPay > Settings > Webhooks (if it has its own)
HITPAY_WEBHOOK_SALT=
# "sandbox" for testing with https://dashboard.sandbox.hit-pay.com, "live" for real payments
HITPAY_MODE=sandbox

# Order emails (optional but recommended), sent from the shop's Gmail account.
# GMAIL_APP_PASSWORD is a 16-character app password from myaccount.google.com/apppasswords
# (needs 2-Step Verification on the account), not the normal Gmail password.
GMAIL_USER=yanachocolateria23@gmail.com
GMAIL_APP_PASSWORD=
# Where new orders are sent
ORDER_EMAIL_TO=yanachocolateria23@gmail.com

# Admin page (/admin) password. Use a long, unique password.
ADMIN_PASSWORD=

# Set automatically when you connect a Vercel Postgres (Neon) database under Storage.
# DATABASE_URL=

# Optional: secret for the "Track your order" links in emails. Defaults to HITPAY_SALT;
# set your own long random value so links keep working if the HitPay salt ever changes.
# ORDER_LINK_SECRET=
